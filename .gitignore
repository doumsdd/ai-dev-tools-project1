*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.Python
venv/
.venv/
ENV/
env/
.venv/bin/
.venv/lib/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
celerybeat-schedule
celerybeat.pid
*.spec.bak

# ----------------------------
# Node.js
# ----------------------------
node_modules/
